                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audio/{session_id}/play/upload": {
      "post": {
        "tags": [
          "Microphone"
        ],
        "summary": "Play Upload",
        "description": "Upload an audio file and play it straight through the microphone.\n\nThe upload is deleted once playback ends; it is a thing to say, not a thing to keep.",
        "operationId": "play_upload_audio__session_id__play_upload_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_play_upload_audio__session_id__play_upload_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioActionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audio/{session_id}/stream": {
      "post": {
        "tags": [
          "Microphone"
        ],
        "summary": "Open Stream",
        "description": "Open an ingest URL for another application to push live audio to.\n\nThe returned URL is self-contained: it carries its own secret, so it can be handed to a TTS engine or a player without also handing over the API token.",
        "operationId": "open_stream_audio__session_id__stream_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenStreamRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Microphone"
        ],
        "summary": "Close Ingest Stream",
        "description": "Close the ingest stream and invalidate its URL.",
        "operationId": "close_ingest_stream_audio__session_id__stream_delete",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioActionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audio/{session_id}/ingest/{token}": {
      "post": {
        "tags": [
          "Microphone"
        ],
        "summary": "Ingest",
        "description": "Receive a live audio stream and play it through the microphone.\n\nThe body is read as it arrives rather than buffered, so this stays live audio: what the pushing application sends now is what the meeting hears now. The write blocks while the sink is full, which is how backpressure reaches an application pushing faster than realtime.",
        "operationId": "ingest_audio_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Microphone"
        ],
        "summary": "Ingest",
        "description": "Receive a live audio stream and play it through the microphone.\n\nThe body is read as it arrives rather than buffered, so this stays live audio: what the pushing application sends now is what the meeting hears now. The write blocks while the sink is full, which is how backpressure reaches an application pushing faster than realtime.",
        "operationId": "ingest_audio_put",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audio/{session_id}/stop": {
      "post": {
        "tags": [
          "Microphone"
        ],
        "summary": "Stop Playback",
        "description": "Stop whatever the bot is playing, optionally muting it again.",
        "operationId": "stop_playback_audio__session_id__stop_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "mute_after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Mute After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioActionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AudioActionResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AudioStateResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "title": "AudioActionResponse",
        "description": "Result of a microphone or playback action."
      },
      "AudioStateResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "status": {
            "$ref": "#/components/schemas/BotStatus"
          },
          "record": {
            "type": "boolean",
            "title": "Record",
            "description": "Whether this session is recording at all"
          },
          "muted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Muted",
            "description": "None when the Teams UI cannot be read"
          },
          "playing": {
            "type": "boolean",
            "title": "Playing",
            "default": false
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind",
            "description": "'file' or 'stream' while playing"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "loop": {
            "type": "boolean",
            "title": "Loop",
            "default": false
          },
          "playback_started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Playback Started At"
          },
          "stream_open": {
            "type": "boolean",
            "title": "Stream Open",
            "default": false
          },
          "stream_connected": {
            "type": "boolean",
            "title": "Stream Connected",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "status",
          "record"
        ],
        "title": "AudioStateResponse",
        "description": "What the bot's microphone is doing right now."
      },
      "Body_play_upload_audio__session_id__play_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Audio file to play into the meeting"
          },
          "loop": {
            "type": "boolean",
            "title": "Loop",
            "default": false
          },
          "volume": {
            "type": "number",
            "title": "Volume",
            "default": 1.0
          },
          "unmute": {
            "type": "boolean",
            "title": "Unmute",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_play_upload_audio__session_id__play_upload_post"
      },
      "BotStatus": {
        "type": "string",
        "enum": [
          "idle",
          "joining",
          "lobby",
          "recording",
          "connected",
          "leaving",
          "denied",
          "not_admitted",
          "error",
          "stopped",
          "interrupted"
        ],
        "title": "BotStatus",
        "description": "Status of the recording bot."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JoinMeetingRequest": {
        "properties": {
          "meeting_url": {
            "type": "string",
            "title": "Meeting Url",
            "description": "Microsoft Teams meeting URL"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference",
            "description": "The caller's own id for this meeting. It comes back on /sessions, /status and the webhook, and a second /join with the same reference while that session is still active returns it instead of sending another bot, so a join can be retried safely."
          },
          "display_name": {
            "type": "string",
            "maxLength": 100,
            "title": "Display Name",
            "description": "Display name to use in the meeting"
          },
          "record": {
            "type": "boolean",
            "title": "Record",
            "description": "Record the meeting. Set false for a bot that only joins to play audio in - nothing is captured, saved or uploaded.",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "meeting_url",
          "display_name"
        ],
        "title": "JoinMeetingRequest",
        "description": "Request model for joining a Teams meeting.",
        "example": {
          "display_name": "Recording Bot",
          "meeting_url": "https://teams.microsoft.com/l/meetup-join/...",
          "record": true
        }
      },
      "OpenStreamRequest": {
        "properties": {
          "format": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Format",
            "description": "ffmpeg input format name. Only needed for headerless audio such as 's16le'; container formats (mp3, ogg, wav) are detected from the bytes."
          },
          "volume": {
            "type": "number",
            "maximum": 4.0,
            "exclusiveMinimum": 0.0,
            "title": "Volume",
            "description": "Playback gain, 1.0 = unchanged",
            "default": 1.0
          },
          "unmute": {
            "type": "boolean",
            "title": "Unmute",
            "description": "Unmute the bot first, so the meeting can hear it",
            "default": true
          }
        },
        "type": "object",
        "title": "OpenStreamRequest",
        "description": "Open an ingest URL another application can push live audio to.",
        "example": {
          "unmute": true,
          "volume": 1.0
        }
      },
      "PlayFileRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "Path to the audio file, relative to MEDIA_DIR"
          },
          "loop": {
            "type": "boolean",
            "title": "Loop",
            "description": "Repeat until stopped",
            "default": false
          },
          "volume": {
            "type": "number",
            "maximum": 4.0,
            "exclusiveMinimum": 0.0,
            "title": "Volume",
            "description": "Playback gain, 1.0 = unchanged",
            "default": 1.0
          },
          "unmute": {
            "type": "boolean",
            "title": "Unmute",
            "description": "Unmute the bot first, so the meeting can hear it",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "PlayFileRequest",
        "description": "Play an audio file that already sits in the media directory.",
        "example": {
          "loop": true,
          "path": "hold-music.mp3",
          "unmute": true,
          "volume": 1.0
        }
      },
      "RecordingResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecordingSession"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "title": "RecordingResponse",
        "description": "Response for recording operations."
      },
      "RecordingSession": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Unique session identifier"
          },
          "meeting_url": {
            "type": "string",
            "title": "Meeting Url"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
