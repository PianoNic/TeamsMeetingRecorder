              }
            }
          }
        }
      }
    },
    "/audio/{session_id}/play": {
      "post": {
        "tags": [
          "Microphone"
        ],
        "summary": "Play File",
        "description": "Play a file from the media directory through the bot's microphone.",
        "operationId": "play_file_audio__session_id__play_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
